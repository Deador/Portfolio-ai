{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "figma": {
      "type": "local",
      "command": ["cmd", "/c", "npx", "-y", "figma-developer-mcp", "--stdio"],
      "enabled": true,
      "environment": {
        "FIGMA_API_KEY": "{env:FIGMA_API_KEY}"
      },
      "timeout": 30000
    }
  }
}
